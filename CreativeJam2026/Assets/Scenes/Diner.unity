    - target: {fileID: 8199070048874438330, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: m_Name
      value: James
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: nextMessageKey
      value: 101
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: interactionText
      value: to talk to James
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: interactionMessage.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: 'interactionMessage.Array.data[0]'
      value: "I have known Adrian and Sophie for quite some time now. I used to be quite good friends with Adrian, before they got married. But now it\u2019s all changed. I hate the way he treats her. She is a beautiful and ambitious woman, and she deserves so much more than what he gives her."
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: 'interactionMessage.Array.data[1]'
      value: "We actually dated for a bit, me and Sophie. A long time ago. Adrian used to be my best friend. But I\u2019ll never forgive him for what he did. He\u2019s a hotheaded selfish prick, and she\u2019s as beautiful as ever."
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: 'interactionMessage.Array.data[2]'
      value: "I know I can offer her the love and stability that he can\u2019t. I come here because it\u2019s the only place I have where I can still see her. I know Adrian hates it, because he messes up my order every time."
      objectReference: {fileID: 0}
    - target: {fileID: 8984048477570034797, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: m_Size.x
      value: 2.6783106
      objectReference: {fileID: 0}
    - target: {fileID: 8984048477570034797, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: m_Size.y
      value: 10.240006
      objectReference: {fileID: 0}
    - target: {fileID: 8984048477570034797, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: m_Center.x
      value: 0.18402012
      objectReference: {fileID: 0}
    - target: {fileID: 8984048477570034797, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: m_Center.z
      value: 0.0000001563648
      objectReference: {fileID: 0}
