      value: Kevin
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: nextMessageKey
      value: 101
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: interactionText
      value: to talk to Kevin
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: interactionMessage.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: 'interactionMessage.Array.data[0]'
      value: "The head chef? He\u2019s stubborn and high strung. He yells all the time and keeps telling me that I\u2019m messing up the orders. I\u2019m just trying to make the plates more interesting, but he insists on staying \u201Cold-school\u201D."
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: 'interactionMessage.Array.data[1]'
      value: "And you know what the worst part of it is? He\u2019s taken multiple of my recipes, and added them to the menu literally days after he yelled my face off for \u201Cnot doing it right\u201D. Then he gets all the credit from everyone else in the kitchen for my work."
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: 'interactionMessage.Array.data[2]'
      value: "He knows I have a better vision for this diner. He\u2019s just scared to admit it."
      objectReference: {fileID: 0}
    - target: {fileID: 8984048477570034797, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: m_Size.x
      value: 2.296463
      objectReference: {fileID: 0}
