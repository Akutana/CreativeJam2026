      propertyPath: m_Size.y
      value: 10.240006
      objectReference: {fileID: 0}
    - target: {fileID: 8984048477570034797, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: m_Size.z
