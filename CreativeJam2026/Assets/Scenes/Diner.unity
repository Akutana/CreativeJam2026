    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: nextMessageKey
      value: 101
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: interactionText
      value: to talk to June
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: interactionMessage.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: 'interactionMessage.Array.data[0]'
      value: "I\u2019m a friend of Sophie\u2019s. I come here after a long day of working and dealing with the kids. She always knows how to cheer me up with some gossip and a drink on the house."
      objectReference: {fileID: 0}
    - target: {fileID: 8682519443021358668, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: 'interactionMessage.Array.data[1]'
      value: "She\u2019s told me a little about the issues she\u2019s been having with her husband. Apparently this gentleman, James, comes to visit her here to offer her some kind of better life. She seems hesitant."
      objectReference: {fileID: 0}
    - target: {fileID: 8984048477570034797, guid: b3f693e1ecc8f694d944803d102f3038, type: 3}
      propertyPath: m_Size.x
