  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1fd8fcbf14f4e2428bb1da066f523e5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Interactable
  interactionText: to talk to Martha
  interactionMessage:
  - "I\u2019ve been working here since the diner opened and, trust me, I see everything."
  - "Sophie resents Adrian for loving his restaurant more than her, but she still loves him so she can\u2019t bring herself to do anything about it."
  - "Kevin, the sous chef has had enough of his boss and I\u2019m sure he would do anything to take ownership of the restaurant."
  - "James comes to see Sophie all the time, I think that if he\u2019s persistent enough he might end up convincing her to go with him and leave it all behind."
  interactionKey: 101
  nextMessageKey: 101
